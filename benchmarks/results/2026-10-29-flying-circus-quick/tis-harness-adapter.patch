+++ b/tests/test_tis_adapter.py
@@ -0,0 +1,26 @@
+import os
+import unittest
+from pathlib import Path
+from flying_circus import runtimes
+from flying_circus.workers import TisWorker, WorkloadError, worker_type
+
+BINARY = os.environ.get('TIS_BENCH_BINARY')
+
+@unittest.skipUnless(BINARY, 'set TIS_BENCH_BINARY to test the tis adapter')
+class TisAdapterTests(unittest.TestCase):
+    def test_runtime_identity_and_worker_selection(self):
+        runtime = runtimes.resolve('tis=' + BINARY, arguments=['--tier', 'native'])
+        self.assertEqual(runtime['engine'], 'tis')
+        self.assertIs(worker_type('tis'), TisWorker)
+
+    def test_fixture_session_reset_and_unicode(self):
+        for tier in ['bytecode', 'native']:
+            with TisWorker(Path(BINARY), 10, ['--tier', tier, '--readonly-regions', '--mutation-regions']) as worker:
+                worker.ready()
+                worker.configure('fixture.py')
+                self.assertEqual(worker.run('data=[1,2,3]', 'fixture.py'), ('', ''))
+                self.assertEqual(worker.run("print('東京', len(data))", 'benchmark.py'), ('東京 3\n', ''))
+                worker.configure('fresh.py')
+                with self.assertRaises(WorkloadError):
+                    worker.run('print(data)', 'fresh.py')
+                self.assertEqual(worker.run('print(4)', 'fresh.py'), ('4\n', ''))
